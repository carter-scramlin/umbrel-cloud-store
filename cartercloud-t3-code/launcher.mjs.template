import http from 'node:http';
import { spawn, execFile } from 'node:child_process';
import { promisify } from 'node:util';

const run = promisify(execFile);
const binary = process.env.T3_BINARY;
const backend = spawn(binary, ['serve', '--host', '127.0.0.1', '--port', '3773', '/projects'], {
  stdio: ['ignore', 'pipe', 'pipe'],
});
// Upstream prints a private startup pairing URL. Keep it out of shared app logs.
backend.stdout.on('data', () => {});
backend.stderr.pipe(process.stderr);
let stopping = false;
backend.on('exit', (code) => { if (!stopping) process.exit(code || 1); });
backend.on('error', () => process.exit(1));

function fail(res, status, text) {
  if (!res.headersSent) res.writeHead(status, { 'Content-Type': 'text/plain', 'Cache-Control': 'no-store' });
  res.end(text);
}

const server = http.createServer(async (req, res) => {
  if (req.url === '/umbrel' || req.url === '/umbrel/') {
    if (req.method !== 'GET') return fail(res, 405, 'Method not allowed');
    if (req.headers['sec-fetch-site'] === 'cross-site') return fail(res, 403, 'Open T3 Code from Umbrel.');
    try {
      const { stdout } = await run(binary, ['auth', 'pairing', 'create', '--ttl', '5m', '--label', 'Umbrel launcher', '--json'], {
        timeout: 20000,
        maxBuffer: 1024 * 1024,
      });
      const grant = JSON.parse(stdout);
      const token = grant.credential;
      if (typeof token !== 'string' || !token) throw new Error('Missing pairing credential');
      res.writeHead(302, {
        Location: '/pair#token=' + encodeURIComponent(token),
        'Cache-Control': 'no-store',
        'Referrer-Policy': 'no-referrer',
      });
      return res.end();
    } catch {
      return fail(res, 503, 'T3 Code is starting. Try opening it again in a moment.');
    }
  }
  const upstream = http.request({
    host: '127.0.0.1', port: 3773, path: req.url, method: req.method, headers: req.headers,
  }, (reply) => {
    res.writeHead(reply.statusCode, reply.headers);
    reply.pipe(res);
  });
  upstream.on('error', () => fail(res, 503, 'T3 Code is starting. Try again in a moment.'));
  req.on('aborted', () => upstream.destroy());
  res.on('close', () => upstream.destroy());
  req.pipe(upstream);
});

server.on('upgrade', (req, socket, head) => {
  const upstream = http.request({ host: '127.0.0.1', port: 3773, path: req.url, headers: req.headers });
  upstream.on('upgrade', (reply, peer, peerHead) => {
    let headers = 'HTTP/1.1 101 Switching Protocols\r\n';
    for (let i = 0; i < reply.rawHeaders.length; i += 2) headers += reply.rawHeaders[i] + ': ' + reply.rawHeaders[i + 1] + '\r\n';
    socket.write(headers + '\r\n');
    if (peerHead.length) socket.write(peerHead);
    if (head.length) peer.write(head);
    socket.pipe(peer).pipe(socket);
    peer.on('error', () => socket.destroy());
    socket.on('error', () => peer.destroy());
    socket.on('close', () => peer.destroy());
    peer.on('close', () => socket.destroy());
  });
  upstream.on('response', (reply) => { socket.end('HTTP/1.1 ' + reply.statusCode + ' Rejected\r\nConnection: close\r\n\r\n'); reply.resume(); });
  upstream.on('error', () => socket.destroy());
  upstream.end();
});
server.listen(8080, '0.0.0.0', () => console.log('T3 Code launcher listening on port 8080.'));
for (const signal of ['SIGTERM', 'SIGINT']) process.on(signal, () => {
  stopping = true;
  server.close();
  backend.kill(signal);
  const timeout = setTimeout(() => { backend.kill('SIGKILL'); process.exit(0); }, 8000);
  timeout.unref();
  backend.once('exit', () => process.exit(0));
});
